{
  "name": "financebuddy",
  "version": "0.1.0",
  "private": true,
  "description": "Security-focused personal finance platform built with React, NestJS, Prisma, and PostgreSQL.",
  "license": "MIT",
  "author": "Arthur de Farias Salmoria",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/salmoriadev/FinanceBuddy.git"
  },
  "bugs": {
    "url": "https://github.com/salmoriadev/FinanceBuddy/issues"
  },
  "homepage": "https://github.com/salmoriadev/FinanceBuddy#readme",
  "workspaces": [
    "apps/web",
    "apps/api"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "npm run dev --workspace=apps/web",
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:api": "npm run start:dev --workspace=apps/api",
    "start": "npm run start --workspace=apps/api",
    "start:api": "npm run start --workspace=apps/api",
    "build": "npm run build:api && npm run build:web",
    "build:web": "npm run build --workspace=apps/web",
    "build:api": "npm run build --workspace=apps/api",
    "lint": "npm run lint:web",
    "lint:web": "npm run lint --workspace=apps/web",
    "test": "npm run test:api && npm run test:web",
    "test:web": "npm run test --workspace=apps/web",
    "test:api": "npm run test --workspace=apps/api",
    "typecheck": "npm run typecheck:api && npm run typecheck:web",
    "typecheck:api": "npm run typecheck --workspace=apps/api",
    "typecheck:web": "npm run typecheck --workspace=apps/web",
    "check": "npm test && npm run lint && npm run typecheck && npm run build",
    "check:fast": "npm test && npm run lint && npm run typecheck"
  }
}
