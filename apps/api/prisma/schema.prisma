generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TransactionType {
  income
  expense

  @@map("transaction_type")
}

model Category {
  id        String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String          @map("user_id") @db.Uuid
  name      String
  color     String
  icon      String
  type      TransactionType @default(expense)
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  transactions Transaction[]
  budgets      Budget[]

  @@map("categories")
}

model User {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String    @db.Citext
  name         String?   @db.Text
  locale       String    @default("en")
  currency     String    @default("BRL")
  passwordHash String    @map("password_hash")
  passwordAlgo String    @map("password_algo")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz(6)

  refreshTokens RefreshToken[]

  @@unique([email])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @map("token_hash")
  userAgent String?   @map("user_agent")
  ipAddress String?   @map("ip_address")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id])

  @@index([userId], map: "idx_refresh_tokens_user")
  @@index([tokenHash], map: "idx_refresh_tokens_hash")
  @@map("refresh_tokens")
}

model Transaction {
  id                 String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             String          @map("user_id") @db.Uuid
  categoryId         String?         @map("category_id") @db.Uuid
  recurrenceParentId String?         @map("recurrence_parent_id") @db.Uuid
  description        String
  amount             Decimal         @db.Decimal(12, 2)
  type               TransactionType
  date               DateTime        @db.Date
  isRecurring        Boolean         @default(false) @map("is_recurring")
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  category          Category?     @relation(fields: [categoryId], references: [id])
  recurrenceParent  Transaction?  @relation("TransactionRecurrence", fields: [recurrenceParentId], references: [id])
  recurringChildren Transaction[] @relation("TransactionRecurrence")

  @@index([userId, date], map: "idx_transactions_user_date")
  @@index([categoryId], map: "idx_transactions_category")
  @@index([recurrenceParentId], map: "idx_transactions_recurrence_parent")
  @@map("transactions")
}

model Budget {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  categoryId String   @map("category_id") @db.Uuid
  amount     Decimal  @db.Decimal(12, 2)
  month      Int
  year       Int
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  category Category @relation(fields: [categoryId], references: [id])

  @@index([userId, year, month], map: "idx_budgets_user_period")
  @@map("budgets")
}

model SavingsGoal {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  name          String
  targetAmount  Decimal   @map("target_amount") @db.Decimal(12, 2)
  currentAmount Decimal   @map("current_amount") @db.Decimal(12, 2)
  targetDate    DateTime? @map("target_date") @db.Date
  color         String
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("savings_goals")
}

model Investment {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  name           String
  category       String?
  assetSymbol    String?   @map("asset_symbol")
  quantity       Decimal?  @db.Decimal(18, 6)
  averagePrice   Decimal?  @map("average_price") @db.Decimal(12, 2)
  investedAmount Decimal   @map("invested_amount") @db.Decimal(12, 2)
  currentValue   Decimal   @map("current_value") @db.Decimal(12, 2)
  marketPrice    Decimal?  @map("market_price") @db.Decimal(12, 2)
  marketValue    Decimal?  @map("market_value") @db.Decimal(12, 2)
  quoteProvider  String?   @map("quote_provider")
  quoteCurrency  String?   @map("quote_currency")
  quoteUpdatedAt DateTime? @map("quote_updated_at") @db.Timestamptz(6)
  startDate      DateTime? @map("start_date") @db.Date
  notes          String?
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId], map: "idx_investments_user")
  @@index([userId, assetSymbol], map: "idx_investments_user_asset_symbol")
  @@map("investments")
}
