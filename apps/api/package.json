{
  "name": "@financebuddy/api",
  "version": "0.1.0",
  "private": true,
  "description": "NestJS API for FinanceBuddy personal finance and portfolio workflows.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/salmoriadev/FinanceBuddy.git",
    "directory": "apps/api"
  },
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "start": "node dist/main",
    "start:dev": "nest start --watch",
    "build": "npm run prisma:generate && nest build",
    "test": "npm run prisma:generate && jest",
    "test:watch": "jest --watch",
    "typecheck": "npm run prisma:generate && tsc -p tsconfig.build.json --noEmit",
    "prisma:generate": "prisma generate"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.1",
    "@nestjs/platform-express": "^11.2.1",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/client": "^5.20.0",
    "argon2": "^0.44.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.6",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.2.1",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.7",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^26.2.0",
    "@types/supertest": "^7.2.1",
    "jest": "^30.4.2",
    "prisma": "^7.9.1",
    "supertest": "^7.0.0",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2"
  }
}
